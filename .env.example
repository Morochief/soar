# =============================================================================
# TECHNOMA SOC — PLANTILLA DE CONFIGURACIÓN DE ENTORNO (.env.example)
# Copia este archivo como '.env' y completa con tus credenciales seguras.
# NUNCA SUBAS EL ARCHIVO '.env' CON CLAVES REALES A REPOSITORIOS PÚBLICOS O PRIVADOS.
# =============================================================================

# --- Stellar Cyber OpenXDR API ---
STELLAR_HOST=https://tu-stellar-tenant.stellarcyber.cloud
STELLAR_EMAIL=tu_usuario@technoma.com.py
STELLAR_TOKEN=tu_api_key_o_token_de_stellar

# --- Motores de Inteligencia Artificial ---
# NVIDIA NIM (Llama 3.2 11B / 90B)
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Google Gemini API
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI API (Opcional)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Servicios de CTI (Cyber Threat Intelligence) ---
VIRUSTOTAL_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ABUSEIPDB_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
URLSCAN_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MXTOOLBOX_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NVD_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Notificaciones y Notificaciones Push (ntfy.sh) ---
NTFY_TOPIC=technoma-soc-alerts
